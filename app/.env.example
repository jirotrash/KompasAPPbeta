# URL de la API FastAPI. En el celular usa la IP de tu PC en la red (no "localhost").
EXPO_PUBLIC_API_URL=http://192.168.0.137:8000

# true = datos de ejemplo (src/services/mock); false = llama a la API real
EXPO_PUBLIC_USE_MOCK=false

# Servicios de mapas (opcionales; por defecto los servidores públicos de OpenStreetMap)
# EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
# EXPO_PUBLIC_ROUTER_URL=https://routing.openstreetmap.de
