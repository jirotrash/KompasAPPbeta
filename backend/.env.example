# Dos bases con el mismo esquema. MONGO_DESTINO elige con cuál trabaja la API: local o atlas
# (si la contraseña tiene @ : / ? # escríbela con urllib.parse.quote_plus)
MONGO_DESTINO=local
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kompas
MONGO_URI_ATLAS=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_ATLAS=kompasbd
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRA_MINUTOS=10080
CORS_ORIGINS=*
GOOGLE_MAPS_API_KEY=tu-llave-de-google
GOOGLE_IDIOMA=es
GOOGLE_REGION=mx
# Asistente (Ollama en la misma PC). El modelo debe soportar tools: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b
